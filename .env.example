# ---------------------------------------------------------------------------
# DODOX Furniture — Public & Server Environment Configuration
# Copy to `.env.local` for Next.js local development (`npm run dev`).
# Never commit real secrets, tokens, or API keys.
# ---------------------------------------------------------------------------

# Application environment: development | staging | production
APP_ENV=development

# Canonical public origin (no trailing slash). Set to your Cloudflare domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional custom public R2 CDN domain (defaults to internal `/api/media` route)
NEXT_PUBLIC_MEDIA_BASE_URL=

# Storefront fallback contact configuration (overridable in /admin/settings -> D1)
NEXT_PUBLIC_WHATSAPP_NUMBER=250788000000
NEXT_PUBLIC_CONTACT_EMAIL=concierge@dodox.rw
NEXT_PUBLIC_CONTACT_PHONE=+250 788 000 000
NEXT_PUBLIC_SHOWROOM_ADDRESS=KG 9 Ave, Nyarutarama, Kigali, Rwanda
NEXT_PUBLIC_SHOWROOM_HOURS=Monday – Saturday, 09:00 – 19:00

# ---------------------------------------------------------------------------
# Server Security Secrets (set via `wrangler secret put` in production)
# ---------------------------------------------------------------------------

# High-entropy secret (minimum 32 characters) used for cryptographic signing & IP hashing
SESSION_SECRET=replace-with-at-least-32-chars-random-secret-key

# One-time secret token (minimum 24 characters) required to create the very first
# Super Admin account at `/admin/bootstrap`. Disabled permanently once a staff user exists.
ADMIN_BOOTSTRAP_TOKEN=replace-with-strong-one-time-bootstrap-token

# ---------------------------------------------------------------------------
# Optional Bot Protection (Cloudflare Turnstile)
# Leave blank in local development to skip Turnstile widget enforcement.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Optional Transactional Email (Resend HTTP API — Workers compatible)
# Leave blank in local development to log emails safely without external calls.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=DODOX Atelier <concierge@dodox.rw>
ADMIN_NOTIFICATION_EMAIL=concierge@dodox.rw
