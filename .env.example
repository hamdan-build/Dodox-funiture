# ---------------------------------------------------------------------------
# DODOX Furniture — environment configuration
# Copy to `.env.local` for local development. All values are optional for the
# demo storefront; the site falls back to safe placeholders when unset.
# ---------------------------------------------------------------------------

# Canonical production origin (no trailing slash). Used for metadata, sitemap,
# robots and absolute Open Graph URLs. Set this to the real Netlify domain.
NEXT_PUBLIC_SITE_URL=https://dodox-furniture.netlify.app

# WhatsApp number in international format, digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=250788000000

# Public contact details shown in the header/footer/contact page.
# These are demonstration placeholders and must be replaced with verified
# business details before launch.
NEXT_PUBLIC_CONTACT_EMAIL=concierge@dodox.rw
NEXT_PUBLIC_CONTACT_PHONE=+250 788 000 000
NEXT_PUBLIC_SHOWROOM_ADDRESS=KG 9 Ave, Nyarutarama, Kigali, Rwanda
NEXT_PUBLIC_SHOWROOM_HOURS=Monday – Saturday, 09:00 – 19:00
